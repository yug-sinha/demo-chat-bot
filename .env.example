# --- Required ---
# Postgres connection string (Neon, Supabase, or any Postgres). Falls back to local sqlite if unset.
DATABASE_URL=postgresql://user:password@host/dbname

# Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Optional (sane defaults provided) ---
# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Gemini model to use for chat
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed origins for CORS (only relevant if frontend
# and backend are deployed on different domains; same-origin deployments don't need this)
CORS_ORIGINS=http://localhost:5173
